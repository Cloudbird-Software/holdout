{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Cloudbird-Software/holdout/main/schema/index.schema.json",
  "title": "holdout entries 索引 schema（ADR-0056）",
  "description": "entries/index.yaml 自身的形状。sha256 = 整个条目对象（含 id/payload/sealed_sha256 等全部字段）的 canonical JSON 哈希——与 sealed_sha256（仅 payload）双层锚定：前者防文件级篡改，后者锚定考卷内容。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "索引格式版本"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HO-[0-9]{4}$"
          },
          "file": {
            "type": "string",
            "pattern": "^HO-[0-9]{4}\\.json$",
            "description": "相对 entries/ 的文件名，必须与 id 一致"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "sha256(canonical JSON of 整个条目对象)——validate_entries.py 强制重算比对"
          }
        }
      }
    }
  }
}
